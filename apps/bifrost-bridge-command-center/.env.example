# Bifrost Bridge Command Center
BIFROST_HOST=127.0.0.1
BIFROST_PORT=4188

# Browser origins permitted to call the Bifrost gateway.
# Keep this explicit. Do not use a wildcard in production.
BIFROST_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Allowlisted realm deployments
MULTIVOICE_BASE_URL=https://obsidian-spire-hud.vercel.app
GODS_EYE_BASE_URL=https://maptheworld.ai
WORLDMONITOR_BASE_URL=https://worldmonitor.app

# OpenRouter — frontier model provider for the bridge.
# Key is server-side only; never exposed to the browser.
# Follows the Camelot-Ecosystem convention (OPENROUTER_API_KEY).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model used when the chat request omits `model`.
# Example free-tier model: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_DEFAULT_MODEL=
# Upstream timeout in ms (clamped to 5000..300000).
OPENROUTER_TIMEOUT_MS=120000
