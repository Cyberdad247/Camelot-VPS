[Unit]
Description=Camelot Authoritative Workspace State Service
After=network.target

[Service]
Type=simple
User=camelot-state
Group=camelot
Slice=camelot-critical.slice
ExecStart=/opt/camelot/bin/state-service
WorkingDirectory=/opt/camelot
Environment=RUST_LOG=info
Environment=CAMELOT_STATE_HOST=127.0.0.1
Environment=CAMELOT_STATE_PORT=3012
Environment=CAMELOT_STATE_DATABASE_URL=sqlite:///var/lib/camelot/state/runtime.sqlite3
Environment=CAMELOT_AUTHORITY_EPOCH=1
EnvironmentFile=-/etc/camelot/state-service.env
Restart=on-failure
RestartSec=3
UMask=0077
MemoryHigh=160M
MemoryMax=224M
CPUQuota=30%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/camelot/state

[Install]
WantedBy=multi-user.target
