[Unit]
Description=Camelot Persona Context Compiler
After=local-fs.target knight-registry.service
Wants=knight-registry.service

[Service]
Type=simple
User=camelot-context
Group=camelot
Slice=camelot-critical.slice
ExecStart=/opt/camelot/bin/context-compiler
WorkingDirectory=/opt/camelot
Environment=RUST_LOG=info
Environment=CAMELOT_CONTEXT_COMPILER_HOST=127.0.0.1
Environment=CAMELOT_CONTEXT_COMPILER_PORT=3017
Environment=CAMELOT_KNIGHT_BUNDLE_DIR=/etc/camelot/knights/sir-synthetos
Environment=CAMELOT_KNIGHT_MAX_RISK_TIER=T1
Environment=CAMELOT_KNIGHT_MAX_COGNITION_CEILING=L1
Environment=CAMELOT_KNIGHT_ALLOWED_EFFECT_CLASSES=ro.fetch,ro.audit,internal.synth
Environment=CAMELOT_CONTEXT_SIGNING_KEY=/var/lib/camelot/context-compiler/spark-ed25519.key
Environment=CAMELOT_CONTEXT_SIGNER_KEY_ID=camelot-context-compiler/default
EnvironmentFile=-/etc/camelot/context-compiler.env
StateDirectory=camelot/context-compiler
Restart=on-failure
RestartSec=3
UMask=0077
MemoryHigh=128M
MemoryMax=160M
CPUQuota=25%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/etc/camelot/knights
ReadWritePaths=/var/lib/camelot/context-compiler

[Install]
WantedBy=multi-user.target
