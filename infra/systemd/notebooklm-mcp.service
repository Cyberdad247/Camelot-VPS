[Unit]
Description=Camelot NotebookLM MCP Sidecar (non-authority provider adapter)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camelot-notebooklm
Group=camelot
Slice=camelot-workers.slice
WorkingDirectory=/var/lib/camelot/notebooklm
ExecStart=/opt/camelot/notebooklm-mcp/bin/notebooklm-mcp
Environment=HOME=/var/lib/camelot/notebooklm
Environment=NOTEBOOKLM_MCP_TRANSPORT=http
Environment=NOTEBOOKLM_MCP_PORT=8484
Environment=NOTEBOOKLM_MCP_HOST=127.0.0.1
EnvironmentFile=-/etc/camelot/notebooklm-mcp.env
Restart=on-failure
RestartSec=5

# This sidecar is an external evidence provider. It never receives Sentinel signing
# material, Ledger signing material, epoch signing credentials, or browser secrets.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/camelot/notebooklm
MemoryHigh=384M
MemoryMax=640M
CPUQuota=50%
TasksMax=96

[Install]
WantedBy=multi-user.target
