[Unit]
Description=Camelot World Tree Graph API
After=network.target

[Service]
Type=simple
Slice=camelot-control.slice
ExecStart=/opt/camelot/bin/world-tree-api
WorkingDirectory=/opt/camelot
Restart=always
RestartSec=3
LimitNOFILE=65536
Environment=GOMAXPROCS=2
Environment=GOGC=50

[Install]
WantedBy=multi-user.target
