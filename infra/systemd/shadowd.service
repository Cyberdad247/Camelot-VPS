[Unit]
Description=Camelot Shadow Subspace Native Knight CPU
After=network.target sentinel.service receipt-service.service
Wants=sentinel.service receipt-service.service

[Service]
Type=simple
Slice=camelot-workers.slice
ExecStart=/opt/camelot/bin/camelot-shadowd
WorkingDirectory=/opt/camelot
Environment=RUST_LOG=info
Environment=CAMELOT_SHADOW_HOST=127.0.0.1
Environment=CAMELOT_SHADOW_PORT=4190
Environment=CAMELOT_SHADOW_ROOT=/var/lib/camelot/shadow
Environment=CAMELOT_SHADOW_DB=/var/lib/camelot/shadow/shadow.db
Environment=CAMELOT_SHADOW_RECEIPT_MIRROR=/var/lib/camelot/shadow/ledger/receipts.jsonl
Environment=CAMELOT_SHADOW_SIGNING_KEY=/var/lib/camelot/shadow/keys/receipt-ed25519.key
Environment=CAMELOT_SHADOW_ALLOW_R6=0
Environment=CAMELOT_SENTINEL_URL=http://127.0.0.1:3002
EnvironmentFile=-/etc/camelot/shadowd.env
Restart=on-failure
RestartSec=3
UMask=0077

# Scarcity protocol: shadow execution must never crowd out the Crown.
MemoryHigh=640M
MemoryMax=768M
CPUQuota=50%
TasksMax=128
LimitNOFILE=4096

# Native service hardening. Puter never receives host authority.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/camelot/shadow

# The Shadow CPU can only speak to local Camelot services such as Bifrost and
# Sentinel. Public WAN/LAN egress is denied below the application layer.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
