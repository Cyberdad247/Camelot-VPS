[Unit]
Description=Camelot Operator Console UI
After=network.target
Wants=network-online.target

[Service]
Type=simple
Slice=camelot-control.slice
ExecStart=/opt/camelot/bin/operator-console
WorkingDirectory=/opt/camelot
Restart=always
RestartSec=3
LimitNOFILE=65536
Environment=GOMAXPROCS=1
Environment=GOGC=50

[Install]
WantedBy=multi-user.target
