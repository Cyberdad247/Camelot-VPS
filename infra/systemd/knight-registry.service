[Unit]
Description=Camelot Signed Knight Registry
After=local-fs.target

[Service]
Type=simple
User=camelot-knight
Group=camelot
Slice=camelot-critical.slice
ExecStart=/opt/camelot/bin/knight-registry
WorkingDirectory=/opt/camelot
Environment=RUST_LOG=info
Environment=CAMELOT_KNIGHT_REGISTRY_HOST=127.0.0.1
Environment=CAMELOT_KNIGHT_REGISTRY_PORT=3016
Environment=CAMELOT_KNIGHT_BUNDLE_DIR=/etc/camelot/knights/sir-synthetos
Environment=CAMELOT_KNIGHT_MAX_RISK_TIER=T1
Environment=CAMELOT_KNIGHT_MAX_COGNITION_CEILING=L1
Environment=CAMELOT_KNIGHT_ALLOWED_EFFECT_CLASSES=ro.fetch,ro.audit,internal.synth
EnvironmentFile=-/etc/camelot/knight-registry.env
Restart=on-failure
RestartSec=3
UMask=0077
MemoryHigh=96M
MemoryMax=128M
CPUQuota=20%
TasksMax=48
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/etc/camelot/knights

[Install]
WantedBy=multi-user.target
