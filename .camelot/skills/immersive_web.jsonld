  "domain": "WebGPU Spatial Optimization & Spline Isolation",
  "execution_logic": "Controls the export and mounting parameters for lightweight interactive 3D elements.",
  "aesthetic_enforcement": {
    "background_mode": "background: transparent; alpha: true",
    "ui_overlays": "Strip all third-party branding, logos, navigation watermarks, and debug controls.",
    "color_tokens": {
      "kinetic_obsidian": "#050505",
