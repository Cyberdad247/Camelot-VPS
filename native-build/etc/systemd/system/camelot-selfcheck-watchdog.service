# SPDX-License-Identifier: MIT
#
# Dead-man's switch for the hub self-check. Driven by camelot-selfcheck-watchdog.timer.
#
# WHY THIS EXISTS
#
# A timer that stops does not fail — it stops. `systemctl --failed` stays clean,
# status.json ages quietly, and the monitoring layer silently reverts to being
# documentation, which is precisely the defect camelot-selfcheck.service was built to
# remove. Nothing scheduled can report its own absence, so the monitor's liveness needs
# a second, independent trigger. This is it: an hourly check on the AGE of the audit's
# status artifact, on a cadence owned by a different timer.
#
# UNLIKE camelot-selfcheck.service, this unit is NOT expected to fail. A failed state
# here means the monitor itself has stopped — a different and more serious condition
# than a failing post-condition, which is why it reuses the same alert path with its
# own subject line rather than being folded into the audit.
#
# The threshold is 3x the audit cadence (45 min vs 15 min), so two missed cycles do not
# alert on a slow host, but a genuinely dead timer is caught within the hour. Override
# with `systemctl edit` → Environment=CAMELOT_SELFCHECK_MAX_AGE_MIN=...

[Unit]
Description=Camelot-OS Hub self-check watchdog (dead-man's switch for the monitor)
Documentation=file:///usr/local/lib/camelot/hub-selfcheck.sh
After=network-online.target
Wants=network-online.target
OnFailure=camelot-selfcheck-alert.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/camelot/hub-selfcheck.sh watchdog
ProtectHome=no
