{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx --no-install prisma generate && node ../../node_modules/typescript/lib/tsc.js && node -e \"require('node:fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "npx --no-install prisma generate && node ../../node_modules/typescript/lib/tsc.js --noEmit",
    "test": "npx --no-install prisma generate && node ../../node_modules/vitest/vitest.mjs run",
    "prisma:generate": "npx --no-install prisma generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@sovereign/db": "^0.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
