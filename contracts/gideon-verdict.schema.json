{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os.dev/contracts/gideon-verdict.schema.json",
  "title": "Camelot Gideon Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdictId",
    "timestamp",
    "tenantId",
    "workspaceId",
    "missionId",
    "taskId",
    "manifestHash",
    "resultHash",
    "authorityEpoch",
    "verdict",
    "reason",
    "evidenceHash",
    "verificationMode",
    "formalProof",
    "signerPublicKey",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "gideon-verdict/1" },
    "verdictId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "resultHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "vfsAttestationId": { "type": ["string", "null"], "maxLength": 160 },
    "authorityEpoch": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "QUARANTINE"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "evidenceHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "verificationMode": { "const": "evidence-gate" },
    "formalProof": { "const": false },
    "signerPublicKey": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signature": { "type": "string", "pattern": "^ed25519:[0-9a-fA-F]{128}$" }
  }
}
