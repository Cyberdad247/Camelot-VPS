{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os.dev/contracts/receipt.schema.json",
  "title": "Camelot Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "sequence",
    "timestamp",
    "tenantId",
    "workspaceId",
    "missionId",
    "taskId",
    "actorId",
    "actionType",
    "resourceUri",
    "manifestHash",
    "resultHash",
    "authorityEpoch",
    "receiptHash",
    "signerPublicKey",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "receipt/2" },
    "receiptId": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workspaceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "missionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "actorId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "actionType": { "type": "string", "minLength": 1, "maxLength": 160 },
    "resourceUri": { "type": "string", "minLength": 1, "maxLength": 512 },
    "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "capabilityLeaseId": { "type": ["string", "null"], "maxLength": 160 },
    "approvalId": { "type": ["string", "null"], "maxLength": 160 },
    "vfsAttestationId": { "type": ["string", "null"], "maxLength": 160 },
    "gideonVerdictId": { "type": ["string", "null"], "maxLength": 160 },
    "arthurResolutionId": { "type": ["string", "null"], "maxLength": 160 },
    "resultHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "authorityEpoch": { "type": "integer", "minimum": 1 },
    "parentReceiptHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "receiptHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "signerPublicKey": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signature": { "type": "string", "pattern": "^ed25519:[0-9a-fA-F]{128}$" }
  }
}
