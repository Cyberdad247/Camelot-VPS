{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/ukg-decision.schema.json",
  "title": "Camelot νKG Baseline-Qualified Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "baseline",
    "subject_ref",
    "disposition",
    "rationale_refs",
    "evidence_refs",
    "decided_at",
    "revisit_after",
    "integrity",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": { "const": "camelot-ukg-decision/1" },
    "object_id": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$" },
    "tenant_id": { "type": "string", "pattern": "^tenant_[A-Za-z0-9_-]+$" },
    "workspace_id": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]+$" },
    "baseline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subject_ref": { "type": "string", "minLength": 1 },
    "disposition": {
      "enum": [
        "QUALIFIED",
        "EXPERIMENTAL",
        "REJECTED_FOR_CURRENT_BASELINE",
        "CONTESTED",
        "REVISIT"
      ]
    },
    "rationale_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "revisit_after": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "camelot-c14n-json/1" },
        "digest_algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_algorithm": { "const": "ed25519" },
        "signature_domain": { "const": "camelot-signature:camelot-ukg-decision/1" },
        "signer_key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    },
    "authority_semantics": { "const": "decision-record-not-authority" }
  }
}
