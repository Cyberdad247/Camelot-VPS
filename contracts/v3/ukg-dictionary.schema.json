{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/ukg-dictionary.schema.json",
  "title": "Camelot νKG Dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "ontology_version",
    "entries",
    "integrity",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": { "const": "camelot-ukg-dictionary/1" },
    "object_id": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$" },
    "tenant_id": { "type": "string", "pattern": "^tenant_[A-Za-z0-9_-]+$" },
    "workspace_id": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]+$" },
    "ontology_version": { "type": "string", "minLength": 1, "maxLength": 160 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "concept_id", "meaning", "aliases"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 160 },
          "concept_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "meaning": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": { "const": "camelot-c14n-json/1" },
        "digest_algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_algorithm": { "const": "ed25519" },
        "signature_domain": { "const": "camelot-signature:camelot-ukg-dictionary/1" },
        "signer_key_id": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    },
    "authority_semantics": { "const": "dictionary-not-authority" }
  }
}
