{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/soul.schema.json",
  "title": "Camelot Persona Soul",
  "description": "Immutable constitutional identity nucleus for a persistent Camelot digital-enterprise persona. A Soul describes identity, purpose, communication continuity, enterprise mandate, and hard prohibitions; it grants no runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "issuer_id",
    "issued_at",
    "not_before",
    "expires_at",
    "lifecycle",
    "derived_from",
    "integrity",
    "canonical_name",
    "persona_class",
    "purpose",
    "enterprise_mandate",
    "worldview",
    "communication_profile",
    "constitutional_limits",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-soul/1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "camelot-c14n-json/1"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signature_domain": {
          "type": "string",
          "const": "camelot-signature:camelot-soul/1"
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "persona_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "enterprise_mandate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "worldview": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "communication_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "interaction_style"
      ],
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "interaction_style": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "default": "en"
        }
      }
    },
    "constitutional_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_semantics": {
      "type": "string",
      "const": "identity-not-authority"
    }
  }
}
