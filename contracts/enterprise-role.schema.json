{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/enterprise-role.schema.json",
  "title": "Camelot Enterprise Role",
  "description": "Organizational role and relationship graph for a persistent digital-enterprise persona. This contract preserves department, responsibility, delegation, collaboration, and escalation continuity without conferring effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "issuer_id",
    "issued_at",
    "not_before",
    "expires_at",
    "lifecycle",
    "derived_from",
    "integrity",
    "persona_id",
    "soul_ref",
    "department",
    "responsibilities",
    "delegates_to",
    "collaborates_with",
    "escalation_targets",
    "shared_context_scopes",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-enterprise-role/1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "camelot-c14n-json/1"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signature_domain": {
          "type": "string",
          "const": "camelot-signature:camelot-enterprise-role/1"
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "persona_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "soul_ref": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "delegates_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "collaborates_with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "escalation_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "shared_context_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authority_semantics": {
      "type": "string",
      "const": "organization-not-authority"
    }
  }
}
