# GEMINI_API_KEY: Development/model-provider credential only. Do not use provider
# credentials as Camelot authority. Production model routing remains lease-bound.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Browser application URL for development callbacks and links.
APP_URL="MY_APP_URL"

# Browser-visible Bifrost compatibility/experience URL. Never place secrets in
# any VITE_ variable because Vite embeds them in the browser bundle.
VITE_BIFROST_URL="http://127.0.0.1:4188"

# Native production Bifrost Hub. The Go service is a trust/transport admission
# boundary and does not grant effect authority.
CAMELOT_BIFROST_HOST="127.0.0.1"
CAMELOT_BIFROST_PORT="3000"
CAMELOT_BIFROST_TRUST_ROOTS_JSON="{}"

# Sentinel is the sole policy/lease/revocation authority. All authority consumers
# must share the current positive authority epoch.
CAMELOT_SENTINEL_TOKEN="replace-with-at-least-24-random-characters"
CAMELOT_SENTINEL_SIGNING_KEY="/var/lib/camelot/sentinel/lease-ed25519.key"
CAMELOT_SENTINEL_ISSUER="camelot-sentinel"
CAMELOT_SENTINEL_PUBLIC_KEY="replace-with-sentinel-32-byte-ed25519-public-key-hex"
CAMELOT_AUTHORITY_EPOCH="1"

# VFS Guardian verifies Sentinel lease/session/path/epoch and emits a signed
# vfs-attestation/2 preflight artifact. Its public key is pinned by executors.
CAMELOT_VFS_HOST="127.0.0.1"
CAMELOT_VFS_PORT="3003"
CAMELOT_VFS_TOKEN="replace-with-at-least-24-random-characters"
CAMELOT_VFS_SIGNING_KEY="/var/lib/camelot/vfs-guardian/attestation-ed25519.key"
CAMELOT_VFS_PUBLIC_KEY="replace-with-vfs-guardian-32-byte-ed25519-public-key-hex"

# Governed Wasmtime node executor. The endpoint is loopback-only and requires
# both its bearer token and a current Sentinel execute:wasm lease plus a signed
# VFS attestation whose content hash exactly matches the supplied module bytes.
CAMELOT_NODE_AGENT_HOST="127.0.0.1"
CAMELOT_NODE_AGENT_PORT="3010"
CAMELOT_NODE_AGENT_TOKEN="replace-with-at-least-24-random-characters"
CAMELOT_NODE_AGENT_MAX_FUEL="10000000"

# Signed receipt ledger. Historical receipts remain valid across authority-epoch
# changes; new receipt drafts must match the current epoch.
CAMELOT_RECEIPT_HOST="127.0.0.1"
CAMELOT_RECEIPT_PORT="3001"
CAMELOT_RECEIPT_URL="http://127.0.0.1:3001"
CAMELOT_RECEIPT_DATABASE_URL="sqlite:///var/lib/camelot/receipts/ledger.sqlite3"
CAMELOT_RECEIPT_SIGNING_KEY="/var/lib/camelot/receipts/ledger-ed25519.key"

# Authoritative workspace state spine. RECEIPTED transitions are checked against
# the receipt ledger for matching tenant/workspace/mission/task/epoch scope.
CAMELOT_STATE_HOST="127.0.0.1"
CAMELOT_STATE_PORT="3012"
CAMELOT_STATE_DATABASE_URL="sqlite:///var/lib/camelot/state/runtime.sqlite3"
CAMELOT_STATE_URL="http://127.0.0.1:3012"

# Gideon is an evidence verifier, not a placeholder formal prover. The current
# verifier publishes formalProof=false and signs PASS/FAIL/INCONCLUSIVE/QUARANTINE.
CAMELOT_GIDEON_HOST="127.0.0.1"
CAMELOT_GIDEON_PORT="3011"
CAMELOT_GIDEON_SIGNING_KEY="/var/lib/camelot/gideon/verdict-ed25519.key"
CAMELOT_GIDEON_PUBLIC_KEY="replace-with-gideon-32-byte-ed25519-public-key-hex"

# Arthur consumes only verdicts signed by the pinned Gideon identity. Arthur can
# RESOLVE/RETRY/REJECT/QUARANTINE but deliberately has no effect execution authority.
CAMELOT_ARTHUR_HOST="127.0.0.1"
CAMELOT_ARTHUR_PORT="3013"
CAMELOT_ARTHUR_SIGNING_KEY="/var/lib/camelot/arthur/resolution-ed25519.key"

# Browser projection context. These are identifiers, never credentials.
VITE_WORLD_TREE_API_URL="http://127.0.0.1:3006"
VITE_CAMELOT_TENANT_ID=""
VITE_CAMELOT_WORKSPACE_ID=""

# Browser-visible Puter Shadow Castle origin. This is a UI URL only. The Puter
# backend talks to Bifrost and never receives the camelot-shadowd bearer token.
VITE_PUTER_SHADOW_URL="http://127.0.0.1:4100"

# Shadow Subspace native executor. The bearer token is server-side only and is
# shared by Bifrost and camelot-shadowd. NEVER prefix it with VITE_.
CAMELOT_SHADOW_URL="http://127.0.0.1:4190"
CAMELOT_SHADOW_TOKEN="replace-with-at-least-24-random-characters"
CAMELOT_SHADOW_HOST="127.0.0.1"
CAMELOT_SHADOW_PORT="4190"
CAMELOT_SHADOW_ROOT="/var/lib/camelot/shadow"

# R6 stays fail-closed until Camelot has a server-authenticated sovereign identity path.
CAMELOT_SHADOW_ALLOW_R6="0"

# Optional cinematic Battle World media.
VITE_BATTLE_CINEMATIC_MEDIA="0"
